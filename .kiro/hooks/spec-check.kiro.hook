{
  "name": "spec-check",
  "description": "Verify Kiro spec/steering invariants (scripts/spec-check.mjs), TypeScript strict typecheck, and adapter conformance tests before commits.",
  "trigger": {
    "type": "manual",
    "command": "npm run spec:check && npm run typecheck && npm test"
  },
  "action": {
    "type": "agentPrompt",
    "prompt": "Run `npm run spec:check && npm run typecheck && npm test` and verify that checked items in `.kiro/specs/clippie/tasks.md` and rules in `.kiro/steering/` hold across `src/`, `native/`, and `tests/`."
  }
}
