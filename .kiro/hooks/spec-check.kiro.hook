{
  "name": "spec-check",
  "description": "Verify TypeScript strict typecheck, adapter conformance tests, and Kiro spec/task alignment before commits.",
  "trigger": {
    "type": "manual",
    "command": "npm run typecheck && npm test"
  },
  "action": {
    "type": "agentPrompt",
    "prompt": "Run `npm run typecheck && npm test` and verify that checked items in `.kiro/specs/clippie/tasks.md` match implemented and tested capabilities in `src/`, `native/`, and `tests/`."
  }
}
